# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example

# local API database
**/fieldsense.db
**/fieldsense.db-*
/web/dist/
/web/node_modules/
/server/**/bin/
/server/**/obj/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# android companion
/android-companion/node_modules
/android-companion/android/.gradle
/android-companion/android/app/build
/android-companion/android/build
/android-companion/android/local.properties
/android-companion/android/captures
*.aab
/dist/
# Keep the published debug APK downloadable from the repo / public URL
!/public/FieldSense-SMS-debug.apk
!/web/public/Darvazeh-SMS.apk
/android-companion/*.apk
/android-companion/android/app/build/

# deploy local overrides
/deploy/k8s/20-secret.local.yaml
/deploy/k8s/*.local.yaml
__pycache__/
/.local/
/.playwright-cli/
/output/playwright/

/scripts/email-outbox-tests/bin/
/scripts/email-outbox-tests/obj/

/scripts/google-auth-tests/bin/
/scripts/google-auth-tests/obj/
