# ASP.NET API (FieldSense__* maps to appsettings FieldSense section)
FieldSense__AdminEmail=admin@ndorbit.co.nz
FieldSense__AdminPassword=ChangeMeAdmin!
FieldSense__JwtKey=dev-fieldsense-change-me-to-a-long-secret-key-32chars-min
FieldSense__AcsConnectionString=
FieldSense__AcsSenderAddress=DoNotReply@ndorbit.co.nz
FieldSense__AcsMock=true
FieldSense__CorsOrigin=http://127.0.0.1:43123,http://localhost:43123,https://atamoradi14.github.io,https://localhost,capacitor://localhost

# Vite web
VITE_API_BASE=http://127.0.0.1:5088

# Production deployment (scripts read the root .env; never commit real values).
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
IMAGE_TAG=
FieldSense__PublicApiBase=

# One-period card checkout. Start in a Stripe sandbox; enable after setup.
Billing__StripeEnabled=false
Billing__StripeSecretKey=
Billing__StripeWebhookSecret=
Billing__PortalOrigin=https://darvazeh.daryajan.com
Billing__LegalName=Niliarya Limited
Billing__TradingName=ND ORBIT
# Toman checkout through the Iran-hosted Ezpay relay (same relay and /broker protocol as Ravand).
# Payments go into Darvazeh's own default wallet, connected by phone number in Admin > Toman receiving wallet.
# Keep the relay key private.
Billing__EzpayEnabled=false
Billing__PaymentRelayEndpoint=https://<iran-relay-host>
Billing__PaymentRelayApiKey=
# Optional: connected once as the default receiving wallet when Ezpay access is active (admin page manages it afterwards).
Billing__DefaultWalletPhone=

# Google sign-in (enable after adding web OAuth credentials)
Google__Enabled=false
Google__ClientId=
Google__ClientSecret=
Google__RedirectUri=https://api1.daryajan.com/api/auth/google/callback
Google__PortalOrigin=https://darvazeh.daryajan.com
